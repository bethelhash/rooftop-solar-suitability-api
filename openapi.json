{"openapi":"3.1.0","info":{"title":"Rooftop Solar Suitability API","description":"True rooftop detection from lat/lng. Finds your building via OpenStreetMap, measures the polygon, calculates usable area, and returns a full solar suitability analysis. Every output cites NREL, IEC, or a peer-reviewed source.","version":"2.0.0"},"paths":{"/":{"get":{"summary":"Root","operationId":"root__get","responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{}}}}}}},"/health":{"get":{"summary":"Health","operationId":"health_health_get","responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{}}}}}}},"/ping":{"get":{"summary":"Ping","description":"Internal keepalive endpoint. Bypasses proxy secret. Returns minimal payload.","operationId":"ping_ping_get","responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{}}}}}}},"/pricing":{"get":{"summary":"Pricing","operationId":"pricing_pricing_get","responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{}}}}}}},"/rooftop/quick":{"post":{"summary":"Rooftop Quick","description":"Free. Lat/lng in → building detected → full solar analysis out.","operationId":"rooftop_quick_rooftop_quick_post","requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/QuickRequest"}}},"required":true},"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/rooftop/full":{"post":{"summary":"Rooftop Full","description":"Pro. Adds 25-yr NPV/IRR/LCOE, demand savings, optional BESS recommendation.","operationId":"rooftop_full_rooftop_full_post","requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/FullRequest"}}},"required":true},"responses":{"200":{"description":"Succ