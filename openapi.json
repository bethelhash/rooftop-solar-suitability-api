description":"2-letter US state code e.g. CA, TX, NY."},"building_type":{"anyOf":[{"type":"string"},{"type":"null"}],"title":"Building Type","description":"See GET /reference/building-types.","default":"generic"},"shading":{"anyOf":[{"type":"string"},{"type":"null"}],"title":"Shading","description":"none / minimal / moderate / significant / severe","default":"minimal"},"orientation":{"anyOf":[{"type":"string"},{"type":"null"}],"title":"Orientation","description":"south / southwest / southeast / west / east / north / flat","default":"south"},"tilt_deg":{"anyOf":[{"type":"number","maximum":90.0,"minimum":0.0},{"type":"null"}],"title":"Tilt Deg","description":"Roof pitch in degrees. Null = unknown (defaults to 10° flat, 20° pitched). 0=flat, 10=low-slope, 20=typical pitched, 45=steep, 90=vertical BIPV."},"electricity_rate_usd_kwh":{"anyOf":[{"type":"number","maximum":1.0,"minimum":0.01},{"type":"null"}],"title":"Electricity Rate Usd Kwh","description":"USD/kWh blended rate. Default: EIA 2024 C&I average.","default":0.126},"annual_kwh_consumption":{"anyOf":[{"type":"number","exclusiveMinimum":0.0},{"type":"null"}],"title":"Annual Kwh Consumption","description":"Annual site electricity consumption kWh."},"demand_kw":{"anyOf":[{"type":"number","exclusiveMinimum":0.0},{"type":"null"}],"title":"Demand Kw","description":"Peak demand kW — enables demand charge savings calculation."},"demand_rate_usd_kw_month":{"anyOf":[{"type":"number","exclusiveMinimum":0.0},{"type":"null"}],"title":"Demand Rate Usd Kw Month","description":"Demand charge $/kW/month. Default: US commercial median.","default":13.5},"obstructions_pct":{"anyOf":[{"type":"number","maximum":0.5,"minimum":0.0},{"type":"null"}],"title":"Obstructions Pct","description":"Fraction of roof blocked by HVAC, skylights etc. 0.0–0.50.","default":0.0},"discount_rate":{"anyOf":[{"type":"number","maximum":0.2,"minimum":0.01},{"type":"null"}],"title":"Discount Rate","description":"WACC for NPV/IRR calculation.","default":0.07},